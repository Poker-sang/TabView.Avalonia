<Project>
	<PropertyGroup>
		<!-- Pinned nightly containing AvaloniaUI/Avalonia#21771 (Fluent 2). -->
		<AvaloniaVersion>12.2.999-cibuild0101188-alpha</AvaloniaVersion>
		<Version>2.0.0-preview.2</Version>
		<AssemblyVersion>2.0.0.0</AssemblyVersion>
		<FileVersion>2.0.0.0</FileVersion>
		<Authors>Poker</Authors>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/Poker-sang/TabView.Avalonia.git</RepositoryUrl>
		<PackageProjectUrl>https://github.com/Poker-sang/TabView.Avalonia</PackageProjectUrl>
		<PackageOutputPath>$(MSBuildThisFileDirectory)output</PackageOutputPath>
	</PropertyGroup>
	<PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
		<!-- .NET 11 Runtime Async V2; keep .NET 10 on compiler-generated async. -->
		<Features>$(Features);runtime-async=on</Features>
	</PropertyGroup>
</Project>
