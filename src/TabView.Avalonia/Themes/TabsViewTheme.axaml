<Styles
    x:Class="TabView.Avalonia.TabsViewTheme"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="Brushes.axaml" />
                <ResourceInclude Source="TabsView.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <StyleInclude Source="Buttons.axaml" />
    <StyleInclude Source="TabsViewItem.axaml" />

</Styles>
