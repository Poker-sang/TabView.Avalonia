<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TabView.Avalonia"
    xmlns:primitives="using:TabView.Avalonia.Primitives">

    <Design.PreviewWith>
        <Border Width="400" Background="{DynamicResource SystemRegionBrush}">
            <local:TabsView>
                <ContentPage Header="Arch">
                    <Border Height="100" Background="AntiqueWhite">
                        <TextBlock
                            FontSize="20"
                            Foreground="Black"
                            Text="Content" />
                    </Border>
                </ContentPage>
                <ContentPage Header="Leaf">
                    <Border Height="100" Background="Green" />
                </ContentPage>
                <ContentPage Header="Disabled" />
            </local:TabsView>
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="WindowThumbStyle" TargetType="{x:Type Control}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="IsHitTestVisible" Value="True" />
    </ControlTheme>

    <ControlTheme x:Key="TabsControlTabControlTheme" TargetType="{x:Type local:DragTabControl}">
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <primitives:TopPanel
                        Name="PART_TopPanel"
                        HorizontalAlignment="Stretch"
                        Background="{TemplateBinding Background}"
                        DockPanel.Dock="{TemplateBinding TabStripPlacement}">
                        <Rectangle
                            Name="PART_LeftDragWindowThumb"
                            MinWidth="{Binding Owner.LeftIndent, RelativeSource={RelativeSource TemplatedParent}}"
                            Fill="Transparent"
                            Theme="{StaticResource WindowThumbStyle}"
                            Win32Properties.NonClientHitTestResult="Caption" />

                        <ContentPresenter
                            Name="PART_LeftHeaderContent"
                            Background="Transparent"
                            Content="{Binding Owner.LeftHeaderContent, RelativeSource={RelativeSource TemplatedParent}}"
                            Theme="{StaticResource WindowThumbStyle}" />

                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />

                        <Button
                            Name="PART_AddItemButton"
                            Classes="AddItemCommandButtonStyle"
                            Command="{Binding Owner.AddItemCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            IsVisible="{Binding Owner.ShowDefaultAddButton, RelativeSource={RelativeSource TemplatedParent}}" />

                        <Rectangle
                            Name="PART_MiddleDragWindowThumb"
                            Fill="Transparent"
                            Theme="{StaticResource WindowThumbStyle}"
                            Win32Properties.NonClientHitTestResult="Caption" />

                        <ContentPresenter
                            Name="PART_RightHeaderContent"
                            Background="Transparent"
                            Content="{Binding Owner.RightHeaderContent, RelativeSource={RelativeSource TemplatedParent}}"
                            Theme="{StaticResource WindowThumbStyle}" />

                        <Rectangle
                            Name="PART_RightDragWindowThumb"
                            MinWidth="{Binding Owner.RightIndent, RelativeSource={RelativeSource TemplatedParent}}"
                            Fill="Transparent"
                            Theme="{StaticResource WindowThumbStyle}"
                            Win32Properties.NonClientHitTestResult="Caption" />
                    </primitives:TopPanel>

                    <ContentPresenter Content="{Binding Owner.LeftContent, RelativeSource={RelativeSource TemplatedParent}}" DockPanel.Dock="Left" />

                    <Panel ClipToBounds="True">
                        <ContentPresenter
                            Name="PART_SelectedContentHost2"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            IsVisible="False" />

                        <ContentPresenter
                            Name="PART_SelectedContentHost"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Panel>
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type local:TabsView}" TargetType="{x:Type local:TabsView}">
        <Setter Property="Background" Value="{DynamicResource TabControlWindowActiveBackgroundBrush}" />
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="AdjacentHeaderItemOffset" Value="-8" />
        <Setter Property="TabItemWidth" Value="250" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Padding="0,8,0,0"
                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalAlignment}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <local:DragTabControl
                        Name="PART_TabControl"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ItemContainerTheme="{StaticResource {x:Type local:TabsViewItem}}"
                        Theme="{StaticResource TabsControlTabControlTheme}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
