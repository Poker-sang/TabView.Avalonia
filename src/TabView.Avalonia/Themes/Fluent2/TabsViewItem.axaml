<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TabView.Avalonia"
    xmlns:primitives="using:TabView.Avalonia.Primitives">

    <ControlTheme x:Key="{x:Type local:TabsViewItem}" TargetType="local:TabsViewItem">
        <Setter Property="FontSize" Value="{DynamicResource TabsViewFluent2ItemFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Background" Value="{DynamicResource TabsViewFluent2ItemBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TabsViewFluent2ItemForeground}" />
        <Setter Property="Padding" Value="{DynamicResource TabsViewFluent2ItemPadding}" />
        <Setter Property="Height" Value="{DynamicResource TabsViewFluent2ItemHeight}" />
        <Setter Property="CornerRadius" Value="{DynamicResource TabsViewFluent2ItemCornerRadius}" />
        <!-- The selected tab's concave feet extend beyond its layout bounds. -->
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <!-- One outline supplies the fill and curved border, including the feet. -->
                    <local:TabsViewItemChrome
                        Name="PART_SelectedBackground"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        FootRadius="{DynamicResource TabsViewFluent2CornerSize}"
                        IsHitTestVisible="False"
                        IsVisible="False" />
                    <Border
                        Name="PART_LayoutRoot"
                        ClipToBounds="True"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Panel>
                            <primitives:TabHeaderPanel
                                Padding="{TemplateBinding Padding}"
                                IsActive="{TemplateBinding IsSelected}"
                                TabWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                                CompactWidthThreshold="{DynamicResource TabsViewCompactWidthThreshold}"
                                MinimumCloseButtonWidth="{DynamicResource TabsViewFluent2CloseButtonGlyphSize}">
                                <primitives:TabHeaderPanel.AllowCloseButton>
                                    <MultiBinding Converter="{x:Static local:ShowDefaultCloseButtonConverter.Instance}">
                                        <Binding Path="$parent[local:DragTabControl].Owner.ShowDefaultCloseButton" />
                                        <Binding Path="$parent[local:DragTabControl].Owner.FixedHeaderCount" />
                                        <Binding Path="LogicalIndex" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </primitives:TabHeaderPanel.AllowCloseButton>
                                <Grid Name="PART_HeaderContent" ColumnDefinitions="Auto,*">
                                    <Viewbox
                                        Name="PART_IconBox"
                                        Width="{DynamicResource TabsViewFluent2IconSize}"
                                        Height="{DynamicResource TabsViewFluent2IconSize}"
                                        Margin="{DynamicResource TabsViewFluent2IconMargin}"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform"
                                        IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <ContentPresenter
                                            Name="PART_IconPresenter"
                                            Content="{TemplateBinding Icon}"
                                            ContentTemplate="{TemplateBinding IconTemplate}"
                                            Foreground="{TemplateBinding Foreground}" />
                                    </Viewbox>
                                    <ContentPresenter
                                        Name="PART_ContentPresenter"
                                        Grid.Column="1"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Content="{TemplateBinding Header}"
                                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}"
                                        FontWeight="{TemplateBinding FontWeight}"
                                        Foreground="{TemplateBinding Foreground}"
                                        RecognizesAccessKey="False" />
                                </Grid>
                                <!-- Above header content, below the close button: preserve drag hit testing. -->
                                <local:LeftPressedThumb
                                    Name="PART_Thumb"
                                    Theme="{StaticResource TabsViewFluent2DragThumbTheme}" />
                                <Button
                                    Name="PART_CloseButton"
                                    Command="{Binding $parent[local:DragTabControl].Owner.CloseItemCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                    Theme="{StaticResource TabsViewFluent2CloseButtonTheme}" />
                            </primitives:TabHeaderPanel>
                            <Border
                                Name="PART_FocusRing"
                                Margin="3"
                                BorderBrush="{DynamicResource TabsViewFluent2FocusBrush}"
                                BorderThickness="2"
                                CornerRadius="4"
                                IsHitTestVisible="False"
                                IsVisible="False" />
                        </Panel>
                    </Border>
                    <Border
                        Name="PART_Separator"
                        Width="1"
                        Margin="0,8"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource TabsViewFluent2SeparatorBrush}"
                        IsHitTestVisible="False" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource TabsViewFluent2ItemBackgroundPointerOver}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource TabsViewFluent2ItemBackgroundPressed}" />
            <Setter Property="Foreground" Value="{DynamicResource TabsViewFluent2ItemForegroundPressed}" />
        </Style>
        <Style Selector="^:separator-hidden /template/ Border#PART_Separator">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource TabsViewFluent2ContentBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TabsViewFluent2ItemForegroundSelected}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="{DynamicResource TabsViewFluent2BorderBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
        </Style>
        <Style Selector="^:selected /template/ local|TabsViewItemChrome#PART_SelectedBackground">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="^[IsDragging=true]">
            <Setter Property="Background" Value="{DynamicResource TabsViewFluent2ContentBackground}" />
        </Style>
        <Style Selector="^[IsDragging=true] /template/ Border#PART_LayoutRoot">
            <Setter Property="BoxShadow" Value="0 2 8 0 #20000000" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource TabsViewFluent2ItemBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TabsViewFluent2ItemForegroundDisabled}" />
        </Style>
        <Style Selector="^:selected:disabled">
            <Setter Property="Background" Value="{DynamicResource TabsViewFluent2ContentBackground}" />
        </Style>
        <Style Selector="^:disabled /template/ Viewbox#PART_IconBox">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
