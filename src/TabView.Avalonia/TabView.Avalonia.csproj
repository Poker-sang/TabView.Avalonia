<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net11.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<IsAotCompatible>true</IsAotCompatible>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<Description>Draggable and tearable tabs based on Avalonia's TabbedPage</Description>
		<PackageTags>TabControl, TabView, Draggable, Tearable, Avalonia, AvaloniaUI</PackageTags>
		<Title>$(AssemblyName)</Title>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />

		<None Include="..\..\README.md" Link="NuGet Info\README.md" Pack="true" PackagePath="/" />
	</ItemGroup>

</Project>
