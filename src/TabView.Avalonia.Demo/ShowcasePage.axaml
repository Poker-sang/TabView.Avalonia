<UserControl
    x:Class="TabView.Avalonia.Demo.ShowcasePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:FluentIcons.Avalonia"
    Foreground="{DynamicResource DemoTextBrush}">

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Padding" Value="24" />
            <Setter Property="Background" Value="{DynamicResource DemoCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DemoCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource DemoCardCornerRadius}" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource DemoSecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1024" Margin="40,36,40,24" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="28">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock FontWeight="SemiBold" Text="TabView.Avalonia" />
                    <TextBlock Classes="secondary" Text="/" />
                    <TextBlock Classes="secondary" Text="Theme preview" />
                </StackPanel>
                <Border Grid.Column="1" Padding="10,4" Background="{DynamicResource DemoAccentBackgroundBrush}" CornerRadius="4">
                    <TextBlock x:Name="ThemeLabel" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DemoAccentBrush}" Text="FLUENT 2" />
                </Border>
            </Grid>

            <StackPanel Grid.Row="1" Spacing="12">
                <TextBlock x:Name="Eyebrow" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DemoAccentBrush}" LetterSpacing="1.5" Text="A WORKSPACE THAT MOVES WITH YOU" />
                <TextBlock x:Name="Heading" FontSize="34" LineHeight="44" FontWeight="SemiBold" Text="A familiar place for every tab." TextWrapping="Wrap" />
                <TextBlock x:Name="Description" MaxWidth="680" HorizontalAlignment="Left" Classes="secondary" FontSize="14" LineHeight="22" Text="A little more space to think. Keep your work in tabs, arrange it your way, and take a page into a new window whenever you need." />
            </StackPanel>

            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Classes="card">
                    <StackPanel Spacing="14">
                        <fluent:SymbolIcon Width="24" Height="24" HorizontalAlignment="Left" Foreground="{DynamicResource DemoAccentBrush}" Symbol="TabDesktop" />
                        <TextBlock Classes="cardTitle" Text="Everything in its place" />
                        <TextBlock Classes="secondary" LineHeight="21" Text="Drag tabs to change their order. Pull one away from the strip to give it a window of its own." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Padding="8,4" Background="{DynamicResource DemoAccentBackgroundBrush}" CornerRadius="4">
                                <TextBlock FontSize="11" Foreground="{DynamicResource DemoAccentBrush}" Text="Drag to reorder" />
                            </Border>
                            <Border Padding="8,4" Background="{DynamicResource DemoAccentBackgroundBrush}" CornerRadius="4">
                                <TextBlock FontSize="11" Foreground="{DynamicResource DemoAccentBrush}" Text="Tear off" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="14">
                        <fluent:SymbolIcon Width="24" Height="24" HorizontalAlignment="Left" Foreground="{DynamicResource DemoAccentBrush}" Symbol="WeatherMoon" />
                        <TextBlock Classes="cardTitle" Text="Comfort in every light" />
                        <TextBlock Classes="secondary" LineHeight="21" Text="Use the theme button in the tab strip to explore light and dark surfaces, text and hover states." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="20" Height="20" Background="#F9F9F9" BorderBrush="#20000000" BorderThickness="1" CornerRadius="10" />
                            <Border Width="20" Height="20" Background="#2C2C2C" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10" />
                            <TextBlock VerticalAlignment="Center" Classes="secondary" FontSize="12" Text="Light &amp; dark" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" Classes="card" Padding="20,16">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                        <fluent:SymbolIcon Foreground="{DynamicResource DemoAccentBrush}" Symbol="Add" />
                    </Viewbox>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="Try a new tab" />
                        <TextBlock Classes="secondary" FontSize="12" Text="Add a page, switch between tabs, or close one with the middle mouse button." />
                    </StackPanel>
                    <Button Grid.Column="2" VerticalAlignment="Center" Classes="accent" Click="NewTab_OnClick" Content="New tab" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
