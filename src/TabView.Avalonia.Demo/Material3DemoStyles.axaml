<Styles x:Class="TabView.Avalonia.Demo.Material3DemoStyles"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TabView.Avalonia.Demo"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:baseline="clr-namespace:Material3Expressive.Baseline;assembly=Material3Expressive">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <m3:MaterialResource>
                    <baseline:ColorScheme Seed="#4285F4" />
                </m3:MaterialResource>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+TypeScale+BodyMedium.Font}}" />
        <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainer}}" />
    </Style>
    <Style Selector="local|ThemeControls ComboBox">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="local|ThemeControls Button">
        <Setter Property="Theme" Value="{StaticResource MaterialTextButtonTheme}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
</Styles>
