<Window
    x:Class="TabView.Avalonia.Demo.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:FluentIcons.Avalonia"
    xmlns:local="using:TabView.Avalonia.Demo"
    xmlns:tabs="using:TabView.Avalonia"
    Title="TabsView · Fluent 2"
    Width="1120"
    Height="760"
    MinWidth="640"
    MinHeight="540"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="40"
    Icon="avares://TabView.Avalonia.Demo/Assets/avalonia-logo.ico"
    WindowStartupLocation="CenterScreen">

    <Grid x:Name="TabsHost">
        <tabs:TabsView
            x:Name="InitialTabsView"
            AddTabButtonClick="TabsView_OnAddTabButtonClick"
            LeftHeaderContentDraggable="True">
            <tabs:TabsView.LeftHeaderContent>
                <Viewbox
                    Width="16"
                    Height="16"
                    Margin="{DynamicResource DemoHeaderIconMargin}"
                    VerticalAlignment="Center">
                    <fluent:SymbolIcon Foreground="{DynamicResource DemoAccentBrush}" Symbol="TabDesktop" />
                </Viewbox>
            </tabs:TabsView.LeftHeaderContent>
            <tabs:TabsView.RightHeaderContent>
                <local:ThemeControls />
            </tabs:TabsView.RightHeaderContent>
        </tabs:TabsView>
    </Grid>
</Window>
